# Release signing configuration template.
# Copy this file to keystore.properties, fill in the values, and keep it out of version control.
# keystore.properties is listed in .gitignore — never commit real credentials.
#
# Play App Signing note: if you publish via Google Play with Play App Signing enabled,
# the upload key goes here (Google re-signs the AAB before distribution with the app signing key).
#
storeFile=../release.jks
storePassword=
keyAlias=
keyPassword=
